<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>gsg</groupId>
  <artifactId>github-integration-check</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.13.1</version>
    </dependency>
  </dependencies>
  <build>
    <!-- GitHub 원본 경로를 옮기지 않고 세 파트를 하나의 실행 프로젝트에서 참조한다. -->
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>integration-tests</testSourceDirectory>
    <resources>
      <resource><directory>hwatu_image</directory><targetPath>resource/hwatu_image</targetPath></resource>
      <resource><directory>data</directory><targetPath>data</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration>
          <includes>
            <include>UI/**/*.java</include><include>server/**/*.java</include>
            <include>GameLogic/src/main/java/**/*.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
